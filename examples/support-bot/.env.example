# Where your Gryt server is. The only setting that has no sensible default.
GRYT_HOST=chat.example.com

# What the member list will call it, before an admin renames it.
GRYT_NICKNAME=Support

# Only if an admin set up the registration in advance and gave you a token.
# Leave it unset to knock and wait for approval, which is the normal way in.
# GRYT_BOT_TOKEN=
